  "components": [
    {
      "name": "Bouton",
      "kind": "button",
      "refersTo": "button",
      "description": "Commande secondaire bordée.",
      "html": "<button class=\"ds-button\">Actualiser</button>",
      "css": ".ds-button{font-family:var(--font-body,\"Manrope Variable\",sans-serif);border:1px solid var(--line,#343d45);border-radius:var(--radius-control,7px);padding:9px 13px;min-height:36px;background:var(--surface,#20272e);color:var(--text,#edf0eb);cursor:pointer;display:inline-flex;gap:8px;align-items:center;justify-content:center;font-size:13px;font-weight:600;transition:background .16s,border-color .16s;}.ds-button:hover{background:var(--hover,#303a42);border-color:#65756d;}.ds-button:active:not(:disabled){background:var(--hover,#303a42);}.ds-button:focus-visible{outline:2px solid var(--accent,#b8dfb4);outline-offset:3px;}.ds-button:disabled{opacity:.45;cursor:not-allowed;}@media(max-width:768px){.ds-button{min-height:44px;}}@media(prefers-reduced-motion:reduce){.ds-button{transition:none;}}"
    },
    {
      "name": "Bouton principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Action principale ; exceptions de survol Papier et Crépuscule conservées.",
      "html": "<button class=\"ds-primary\">Enregistrer</button>",
      "css": ".ds-primary{font-family:var(--font-body,\"Manrope Variable\",sans-serif);border:1px solid var(--line,#343d45);border-radius:8px;padding:9px 13px;min-height:36px;background:var(--surface,#20272e);color:var(--text,#edf0eb);cursor:pointer;display:inline-flex;gap:8px;align-items:center;justify-content:center;font-size:13px;font-weight:600;transition:background .16s,border-color .16s;}.ds-primary:hover{background:var(--hover,#303a42);border-color:#65756d;}.ds-primary:active:not(:disabled){background:var(--hover,#303a42);}.ds-primary:focus-visible{outline:2px solid var(--accent,#b8dfb4);outline-offset:3px;}.ds-primary:disabled{opacity:.45;cursor:not-allowed;}@media(max-width:768px){.ds-primary{min-height:44px;}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;}}.ds-primary{background:var(--accent,#b8dfb4);border-color:var(--accent,#b8dfb4);color:var(--accent-ink,#213a26);font-weight:750;padding:11px 16px;border-radius:7px;gap:9px;}.ds-primary:hover{background:color-mix(in srgb,var(--accent,#b8dfb4) 88%,var(--text,#edf0eb));}.ds-primary:active:not(:disabled){background:var(--accent,#b8dfb4);}:host-context([data-theme=\"light\"]) .ds-primary:hover{background:#294c30;border-color:#294c30;color:#fff;}:host-context([data-theme=\"dusk\"]) .ds-primary:hover{background:#e4d2ff;}"
    },
    {
      "name": "Bouton d’icône",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Commande compacte avec nom accessible.",
      "html": "<button class=\"ds-icon\" aria-label=\"Fermer\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></button>",
      "css": ".ds-icon{border:0;background:transparent;padding:7px;color:var(--muted,#adb7bd);border-radius:5px;min-height:36px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;}.ds-icon:hover,.ds-icon:active{color:var(--text,#edf0eb);background:var(--hover,#303a42);}.ds-icon:focus-visible{outline:2px solid var(--accent,#b8dfb4);outline-offset:3px;}@media(max-width:768px){.ds-icon{min-height:44px;}}"
    },
    {
      "name": "Champ",
      "kind": "input",
      "refersTo": "input",
      "description": "Champ fluide dans son conteneur, avec libellé visible.",
      "html": "<label class=\"ds-field\">Nom<input class=\"ds-input\" placeholder=\"Nom du salon\" /></label>",
      "css": ".ds-field{font-family:var(--font-body,\"Manrope Variable\",sans-serif);display:grid;gap:8px;color:var(--muted,#adb7bd);font-size:13px;}.ds-input{font:inherit;font-size:14px;width:100%;box-sizing:border-box;min-width:0;border:1px solid var(--line,#343d45);background:var(--bg,#171d23);border-radius:var(--radius-control,7px);color:var(--text,#edf0eb);padding:11px 12px;}.ds-input::placeholder{color:var(--muted,#adb7bd);}.ds-input:focus{border-color:var(--accent,#b8dfb4);}.ds-input:focus-visible{outline:2px solid var(--accent,#b8dfb4);outline-offset:3px;}@media(max-width:768px){.ds-input{font-size:16px;}}"
    },
    {
      "name": "Tag",
      "kind": "chip",
