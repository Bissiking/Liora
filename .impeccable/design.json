      "css": ".ds-tag{font-family:var(--font-body,\"Manrope Variable\",sans-serif);font-size:10px;font-weight:650;color:var(--muted,#adb7bd);border:1px solid var(--line,#343d45);padding:5px 9px;border-radius:5px;white-space:nowrap;}"
    },
    {
      "name": "Navigation globale active",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Entrée textuelle de la sidebar unique.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Mon espace\"><h2>Mon espace</h2><button class=\"ds-nav-item\" aria-current=\"page\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10H3Z\"/><path d=\"M9 20v-7h6v7\"/></svg><span>Accueil</span></button></nav>",
      "css": ".ds-nav{font-family:var(--font-body,\"Manrope Variable\",sans-serif);width:208px;}.ds-nav h2{font-size:11px;font-weight:600;color:var(--muted,#adb7bd);padding:0 12px;margin:0 0 7px;}.ds-nav-item{font:inherit;border:0;background:var(--nav-active,color-mix(in srgb,var(--accent,#b8dfb4) 12%,var(--side,#1c232a)));color:var(--text,#edf0eb);font-size:13px;font-weight:650;width:100%;padding:9px 12px;min-height:36px;border-radius:8px;display:flex;gap:10px;align-items:center;text-align:left;cursor:pointer;}.ds-nav-item svg{color:var(--accent,#b8dfb4);}.ds-nav-item:hover,.ds-nav-item:active{background:var(--nav-active,color-mix(in srgb,var(--accent,#b8dfb4) 12%,var(--side,#1c232a)));}.ds-nav-item:focus-visible{outline:2px solid var(--accent,#b8dfb4);outline-offset:3px;}:host-context([data-theme=\"light\"]) .ds-nav-item{background:#dce8d7;color:var(--accent,#365f3d);}@media(max-width:768px){.ds-nav-item{font-size:14px;min-height:44px;}}"
    },
    {
      "name": "Galerie des univers",
      "kind": "custom",
      "refersTo": "theme-preview",
      "description": "Miniature Atelier avec police et rayons isolés du monde actif. Les couleurs propres au choix sont intentionnelles.",
      "html": "<label class=\"ds-theme-choice\"><span class=\"ds-theme-preview\"><span class=\"ds-theme-preview-nav\"></span><span class=\"ds-theme-preview-content\"><strong>Aa</strong><span></span><span></span><i></i></span></span><input type=\"radio\" name=\"ds-theme\" checked><strong>Atelier</strong><small>Papier ivoire, titres sérif et lignes éditoriales.</small></label>",
      "css": ".ds-theme-choice{font-family:var(--font-body,\"Manrope Variable\",sans-serif);display:grid;grid-template-columns:18px minmax(0,1fr);gap:8px;padding:14px;border:1px solid var(--accent,#b8dfb4);outline:1px solid var(--accent,#b8dfb4);border-radius:var(--radius-panel,12px);color:var(--text,#edf0eb);background:var(--surface,#20272e);cursor:pointer;}.ds-theme-choice:hover{border-color:var(--accent,#b8dfb4);}.ds-theme-choice input{width:16px;accent-color:var(--accent,#b8dfb4);}.ds-theme-choice input:focus-visible{outline:2px solid var(--focus,var(--accent,#b8dfb4));outline-offset:3px;}.ds-theme-choice>strong{grid-column:2;}.ds-theme-choice>small{grid-column:1/-1;font-size:12px;line-height:1.5;color:var(--muted,#adb7bd);}.ds-theme-preview{--font-body:\"Manrope Variable\",sans-serif;--font-heading:Georgia,\"Times New Roman\",serif;--radius-control:3px;--radius-panel:3px;--radius-card:2px;grid-column:1/-1;display:flex;height:82px;overflow:hidden;border-radius:var(--radius-panel);font-family:var(--font-body);background:#f2efe6;color:#292a26;border:1px solid #c9c5b9;}.ds-theme-preview-nav{width:24%;background:#e8e3d7;border-right:1px solid #c9c5b9;}.ds-theme-preview-content{flex:1;padding:12px;display:grid;gap:4px;}.ds-theme-preview-content strong{font-family:var(--font-heading);font-size:20px;font-weight:500;line-height:1;}.ds-theme-preview-content>span{height:3px;background:#c9c5b9;width:75%;}.ds-theme-preview-content>span+span{width:50%;}.ds-theme-preview-content>i{background:#375844;width:28%;height:9px;border-radius:var(--radius-control);}"
    },
    {
      "name": "Message entre amis",
      "kind": "card",
      "refersTo": "friend-message",
      "description": "Bulle personnelle envoyée, distincte du transcript des salons.",
      "html": "<article class=\"ds-friend-bubble\"><p>Je prépare le prochain rendez-vous.</p><small>03/10/2026 14:30 · Envoyé</small></article>",
      "css": ".ds-friend-bubble{font-family:var(--font-body,\"Manrope Variable\",sans-serif);max-width:80%;background:var(--selection,color-mix(in srgb,var(--accent,#b8dfb4) 13%,var(--surface,#20272e)));color:var(--text,#edf0eb);padding:12px 16px;border:1px solid color-mix(in srgb,var(--accent,#b8dfb4) 35%,var(--line,#343d45));border-radius:var(--radius-card,9px);}.ds-friend-bubble p{white-space:pre-wrap;overflow-wrap:anywhere;margin:0 0 8px;line-height:1.7;font-size:14px;}.ds-friend-bubble small{font-size:10px;color:var(--muted,#adb7bd);}@media(max-width:760px){.ds-friend-bubble{max-width:90%;}}"
    },
    {
      "name": "Épingle de lieu visité",
      "kind": "custom",
      "refersTo": "navigation-active",
      "description": "Marqueur SVG Visité avec libellé accessible, dans le parcours recherche géographique → détail → À essayer/Visité ; ajout manuel dans un panneau, au clic/drag ou centre clavier.",
      "html": "<button class=\"ds-place-marker\" aria-label=\"Lieu · Visité\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 12 2 2 4-4\"/><circle cx=\"12\" cy=\"12\" r=\"9\"/></svg></button>",
      "css": ".ds-place-marker{width:30px;height:30px;padding:0;display:grid;place-items:center;background:var(--accent,#b8dfb4);color:var(--accent-ink,#213a26);border:2px solid var(--accent,#b8dfb4);border-radius:50% 50% 50% 3px;box-shadow:0 2px 5px #0003;cursor:pointer;}.ds-place-marker:hover,.ds-place-marker:active{background:var(--accent-hover,var(--accent,#b8dfb4));}.ds-place-marker:focus-visible{outline:2px solid var(--focus,var(--accent,#b8dfb4));outline-offset:3px;}"
    },
    {
      "name": "Rubrique des réglages active",
      "kind": "nav",
      "refersTo": "settings-navigation-active",
      "description": "Navigation contextuelle avec bande de sélection de 1 px.",
      "html": "<nav aria-label=\"Préférences\"><button class=\"ds-setting-active\" aria-current=\"page\">Apparence</button></nav>",
      "css": ".ds-setting-active{font-family:var(--font-body,\"Manrope Variable\",sans-serif);font-size:12px;font-weight:600;padding:11px 12px;min-height:40px;width:100%;text-align:left;background:var(--selection,color-mix(in srgb,var(--accent,#b8dfb4) 13%,var(--surface,#20272e)));color:var(--text,#edf0eb);border:0;border-radius:var(--radius-control,7px);box-shadow:inset 1px 0 var(--accent,#b8dfb4);cursor:pointer;}.ds-setting-active:hover,.ds-setting-active:active{background:var(--selection,color-mix(in srgb,var(--accent,#b8dfb4) 13%,var(--surface,#20272e)));}.ds-setting-active:focus-visible{outline:2px solid var(--focus,var(--accent,#b8dfb4));outline-offset:3px;}@media(max-width:768px){.ds-setting-active{min-height:44px;}}"
    }
  ],
  "narrative": {
    "northStar": "Le poste de travail LUMA",
    "overview": "Le poste de travail LUMA conserve la sidebar et les index contextuels de 0.4.9. La 0.5.0 ajoute trois univers construits : Atelier (Georgia, ivoire et angles fins), Orbital (cobalt, surfaces arrondies et ombre légère), Terminal (monospace et angles droits). Six palettes classiques demeurent. La galerie isole explicitement couleurs, polices et rayons de chaque miniature.\n\nCascade : styles.css, ux.css, themes/index.css puis release-050.css. Réglages guidés, messagerie personnelle et carte/collection réutilisent les tokens ; les sélections de réglages utilisent un trait de 1 px, les priorités warning et les marqueurs des SVG. Captures 050 locales avec tuiles synthétiques, sans certification OSM/GPS. Détecteur exécuté une fois, 0 antipattern et 30 avis de documentation ; verdict ship limité aux cinq corrections examinées.\n\nSuivi Mes lieux : recherche géographique explicite par ville/adresse/Burger King, résultat puis À essayer/Visité directement. Ajout manuel dans un panneau inline, emplacement cliqué/déplaçable ou placé au centre au clavier ; date pour Visité uniquement, notes/partage et coordonnées avancées repliés. Pied sticky et panneau avant la carte sur mobile. Revue finale ship sans correction matérielle sur neuf captures valides ; tuiles simulées et fixtures Photon, sans qualification géographique réelle.",
    "keyCharacteristics": [
      "Sidebar globale textuelle et index contextuels.",
      "Surfaces mates et états teintés par le thème.",
      "Manrope auto-hébergée, corps de travail 14 px.",
      "Dock mobile et tiroirs indépendants, états écrits.",
      "Neuf choix : six palettes et trois univers structurants.",
      "Galerie isolée, états sémantiques et marqueurs SVG.",
      "Ressources personnelles et aides de rubrique.",
      "Recherche explicite et suivi de lieu direct, ajout manuel dans la page."
    ],
    "rules": [
      {
        "name": "The Theme Rule",
        "body": "Réutiliser les variables du thème pour les nouvelles surfaces et contrôles ; accompagner les couleurs de statut d’un état écrit.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do réutiliser la sidebar et les index contextuels.",
      "Do conserver les neuf thèmes et leurs variables.",
      "Do garder la continuité du transcript et les retours à la ligne.",
      "Do rendre les actions visibles sur mobile et accessibles au clavier.",
      "Do garder le défilement du Kanban dans son cadre.",
      "Do annoncer les états et respecter la réduction des mouvements.",
      "Do isoler police et rayons des miniatures.",
      "Do utiliser warning/danger avec un état écrit.",
      "Do garder les repères de sélection fins à 1 px.",
      "Do garder Mes lieux en parcours recherche → résultat → état direct, avec ajout manuel dans un panneau et placement accessible."
    ],
    "donts": [
      "Don't réintroduire un rail d’icônes séparé.",
      "Don't transformer chaque rubrique ou message en carte avec ombre décorative ; préserver la seule ombre légère Orbital.",
      "Don't réserver une action au survol sur mobile.",
      "Don't inventer des comptes ou une rubrique d’archives.",
      "Don't assimiler Papier à une inversion ou ignorer les exceptions réelles de la cascade.",
      "Don't confondre cartes de test synthétiques et preuve géographique réelle.",
      "Don't imposer une modale ou la saisie des coordonnées pour ajouter un lieu ; les coordonnées restent avancées et repliées."
    ]
  }
