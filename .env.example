DATABASE_URL=postgresql://liora:change-me@localhost:5432/liora
APP_URL=http://localhost:4310
PORT=4310
HOST=127.0.0.1
SESSION_SECRET=
KYROS_BASE_URL=https://kyros.example.com
KYROS_CLIENT_ID=
KYROS_CLIENT_SECRET=
KYROS_ISSUER=
KYROS_AUDIENCE=kyros-modules
KYROS_RESOURCE_AUDIENCE=kyros:liora
KYROS_SCOPES=profile email offline_access
# Explicit Kyros subject allowed to claim the seeded LUMA workspace. Never first-user-wins.
BOOTSTRAP_OWNER_KYROS_ID=
ARGOS_BASE_URL=
ARGUS_HEALTH_URL=
MONITOR_INTERVAL_MS=60000
HEARTBEAT_TIMEOUT_SECONDS=180
UPLOAD_DIR=./uploads
# Web Push optionnel : générer une fois avec npm run push:keys, puis garder ces clés stables.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Recherche de lieux : services remplaçables par des instances hébergées.
# Requêtes explicites uniquement, cache et limitation côté Liora.
PLACES_GEOCODER_URL=https://photon.komoot.io/api/

# Notes datées BrainDump : client Liora autorisé explicitement par BrainDump/Kyros.
BRAINDUMP_BASE_URL=
BRAINDUMP_ALLOW_PRIVATE=false
# Google Calendar OAuth : application Web, callback APP_URL/api/v1/google-calendar/callback.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
